._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------
# JetBrains WebStorm / IntelliJ IDEA
# ---------------------------------------------------------------
# Whole project config folder.
# Remove this line if you want to share run configurations,
# code styles, dictionaries or inspections with the team.
.idea/

# JetBrains-specific files (also covered by .idea/.gitignore)
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/tasks.xml
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/dictionaries/
.idea/*.iml
.idea/modules.xml
.idea/gradle.xml
.idea/libraries/
.idea/compiler.xml
.idea/encodings.xml
.idea/misc.xml
.idea/vcs.xml
.idea/inspectionProfiles/
.idea/codeStyles/
.idea/scopes/
.idea/runConfigurations/

